<svg class="master-chip-art" viewBox="0 0 48 48" fill="none" aria-hidden="true">
    @foreach (var (pin, index) in PINS.Select((pin, index) => (pin, index)))
    {
        <path class="master-pin" d="@pin" style="--n:@index" />
    }
    <path class="master-body" d="M13 9H39V39H9V13Z" />
    <path class="master-trace" d="M9 13L17 17M39 9L31 17M39 39L31 31M9 39L17 31" />
    <rect class="master-die" x="17" y="17" width="14" height="14" />
    <rect class="master-pulse" x="20.5" y="20.5" width="7" height="7" />
</svg>

@code {
    private static readonly string[] PINS = BuildPins();

    private static string[] BuildPins()
    {
        int[] offsets = [15, 19, 24, 29, 33];
        var top = offsets.Select(x => $"M{x} 3V9");
        var right = offsets.Select(y => $"M39 {y}H45");
        var bottom = Enumerable.Reverse(offsets).Select(x => $"M{x} 39V45");
        var left = Enumerable.Reverse(offsets).Select(y => $"M3 {y}H9");
        return [.. top, .. right, .. bottom, .. left];
    }
}
