    private void HandleKey(string key)
    {
        switch (key)
        {
            case "Escape":
                if (closeOffer is not null)
                {
                    closeOffer = null;
                }
                else if (menu is not null || newMenu is not null || categoryMenu is not null)
                {
                    menu = null;
                    newMenu = null;
                    categoryMenu = null;
                }
                else if (statsOpen)
                {
                    ToggleStats();
                }
                else if (sendOpen)
                {
                    CloseSend();
                }
                else if (notesOpen)
                {
                    notesOpen = false;
                }
                else if (detailKey is not null)
                {
                    detailKey = null;
                }
                else
                {
                    selectedKey = null;
                }

                break;
            case "ArrowRight":
                SelectToward(CanvasDirection.Right);
                break;
            case "ArrowLeft":
                SelectToward(CanvasDirection.Left);
                break;
            case "ArrowDown":
                SelectToward(CanvasDirection.Down);
                break;
            case "ArrowUp":
                SelectToward(CanvasDirection.Up);
                break;
            case " ":
                _ = JS.InvokeVoidAsync("canvas.fit", false);
                break;
            case "Enter" when selectedKey is not null:
                _ = Open(selectedKey);
                break;
            case "z" when selectedKey is not null:
                detailKey = detailKey == selectedKey ? null : selectedKey;
                break;
            case "m" when selectedKey is not null:
                var agent = visible.FirstOrDefault(a => a.Key == selectedKey);
                Act(selectedKey, agent?.IsRead == true ? MenuAction.MarkUnread : MenuAction.MarkRead);
                break;
            case "r" when selectedKey is not null && visible.FirstOrDefault(a => a.Key == selectedKey) is { IsAlive: false }:
                Act(selectedKey, MenuAction.Resume);
                break;
            case "p" when selectedKey is not null:
                Act(selectedKey, MenuAction.Pin);
                break;
            case "Delete" when selectedKey is not null:
                Act(selectedKey, MenuAction.Dismiss);
                break;
            case "F2" when selectedKey is not null:
                StartRename(selectedKey);
                break;
            case "c":
                ToggleChat();
                break;
            case "t":
                ToggleNotes();
                break;
            case "a":
                OpenSend(null);
                break;
        }
    }

    private void SelectToward(CanvasDirection direction)
    {
        var shown = visible.Select(a => a.Key).ToHashSet();
        var board = Hub.Board();
        var cards = board.Cards.Where(card => shown.Contains(card.Key)).ToDictionary(card => card.Key, card => card.Value);
        if (visible.FirstOrDefault(CanvasLayout.IsDocked) is { } docked)
        {
            cards[docked.Key] = CanvasLayout.DockedAt(board);
        }

        var next = selectedKey is { } from && cards.ContainsKey(from) ? CanvasLayout.Nearest(from, direction, cards) : CanvasLayout.First(cards);
        if (next is not null)
        {
            selectedKey = next;
            _ = JS.InvokeVoidAsync("canvas.reveal", next);
        }
    }

    private void Notify(string text, string kind, int lasts = TOAST_MS)
    {
        var toast = new Toast(++toastId, text, kind);
        toasts.Add(toast);
        if (toasts.Count > 4)
        {
            toasts.RemoveAt(0);
        }

        _ = Task.Delay(lasts).ContinueWith(_ => InvokeAsync(() =>
        {
            toasts.Remove(toast);
            StateHasChanged();
        }), TaskScheduler.Default);
    }

    public void Dispose()
    {
        Hub.Changed -= OnHubChanged;
        selfReference?.Dispose();
    }

    private sealed record Toast(int Id, string Text, string Kind);
