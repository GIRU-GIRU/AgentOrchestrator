    private List<MenuItem?> MenuFor(AgentSnapshot agent)
    {
        var tool = agent.Kind == AgentKind.Claude ? "Claude Code" : "Codex";
        var items = new List<MenuItem?> { new(MenuAction.Details, "View details", "z") };
        if (agent.IsAlive)
        {
            items.Add(new MenuItem(MenuAction.Raise, "Raise its window", "enter"));
        }

        if (agent.IsAlive && !agent.IsMasterAgent && !AgentManager.Core.Transcripts.BridgeRules.IsAstraTitle(agent.Name))
        {
            items.Add(new MenuItem(MenuAction.Rename, "Rename window (/rename)", "f2"));
        }

        if (agent.State is AgentState.NeedsInput or AgentState.Asked)
        {
            items.Add(new MenuItem(MenuAction.MarkRead, "Mark as read", "m"));
        }
        else if (agent.IsRead)
        {
            items.Add(new MenuItem(MenuAction.MarkUnread, "Mark as unread", "m"));
        }

        if (!agent.IsAlive)
        {
            items.Add(new MenuItem(MenuAction.Resume, $"Open in {tool} (/resume)", "r"));
        }

        var pinLabel = agent.IsMasterAgent ? (agent.Pinned ? "Unpin (onto the canvas)" : "Pin (dock top left)") : agent.Pinned ? "Unpin" : "Pin to the top";
        items.Add(new MenuItem(MenuAction.Pin, pinLabel, "p"));
        if (agent.IsAlive)
        {
            items.Add(new MenuItem(MenuAction.SendMessage, "Send a message…", ""));
        }

        items.Add(new MenuItem(MenuAction.ShowMessages, "Show its messages", ""));
        items.Add(null);
        items.Add(new MenuItem(MenuAction.CopyResume, "Copy resume command", ""));
        items.Add(new MenuItem(MenuAction.CopySessionId, "Copy session id", ""));
        items.Add(new MenuItem(MenuAction.CopyLastText, "Copy last message", ""));
        items.Add(new MenuItem(MenuAction.OpenFolder, "Open folder", ""));
        items.Add(new MenuItem(MenuAction.RevealTranscript, "Reveal transcript", ""));
        items.Add(null);
        if (agent.IsAlive)
        {
            items.Add(new MenuItem(MenuAction.Dismiss, "Hide until it acts", "del"));
        }

        items.Add(agent.IsAlive
            ? new MenuItem(MenuAction.CloseAgent, "Close window", CardClose.ClosesOnCtrlClick(agent) ? "ctrl+click" : "", true)
            : new MenuItem(MenuAction.Dismiss, "Close window", "ctrl+click", true));
        return items;
    }

    private Task ChooseAsync(string key, MenuAction action)
    {
        var needsConfirm = action == MenuAction.CloseAgent && armedClose != key;
        if (needsConfirm)
        {
            armedClose = key;
            return Task.CompletedTask;
        }

        armedClose = null;
        menu = null;
        Act(key, action);
        return Task.CompletedTask;
    }

    private void Act(string key, MenuAction action)
    {
        var agent = snapshot.Agents.FirstOrDefault(a => a.Key == key);
        if (agent is null)
        {
            return;
        }

        switch (action)
        {
            case MenuAction.Details:
                detailKey = key;
                break;
            case MenuAction.Raise:
                _ = Open(key);
                break;
            case MenuAction.MarkRead:
                Hub.MarkRead(key);
                Notify($"✓ {agent.Name} marked read", "ok");
                break;
            case MenuAction.MarkUnread:
                Hub.MarkUnread(key);
                break;
            case MenuAction.Resume:
                Hub.Resume(key);
                Notify($"▸ {agent.ResumeCommand}", "ok");
                break;
            case MenuAction.CloseAgent:
                BeginClose(agent);
                break;
            case MenuAction.Dismiss:
                _ = JS.InvokeVoidAsync("fx.vanish", key);
                removedNow.Add(key);
                Refilter();
                detailKey = detailKey == key ? null : detailKey;
                _ = Task.Run(() => Hub.Dismiss(key));
                break;
            case MenuAction.Rename:
                StartRename(key);
                break;
            case MenuAction.Pin:
                Hub.TogglePin(key);
                break;
            case MenuAction.ShowMessages:
                chatAgent = key;
                SetChat(true);
                break;
            case MenuAction.SendMessage:
                OpenSend(key);
                break;
            case MenuAction.CopyResume:
                Copy(agent.ResumeCommand);
                break;
            case MenuAction.CopySessionId:
                Copy(agent.SessionId);
                break;
            case MenuAction.CopyLastText:
                Copy(agent.LastText ?? "");
                break;
            case MenuAction.OpenFolder:
                AgentManager.Core.Windows.Launcher.OpenFolder(agent.Cwd ?? "");
                break;
            case MenuAction.RevealTranscript:
                AgentManager.Core.Windows.Launcher.RevealFile(agent.TranscriptPath);
                break;
        }
    }

    /// <summary>The animation starts on the click; asking the window to close attaches to a console and reads the process table, which would stall the page.</summary>
    private void BeginClose(AgentSnapshot agent)
    {
        if (IsBeingClosed(agent))
        {
            return;
        }

        closingNow.Add(agent.Key);
        detailKey = detailKey == agent.Key ? null : detailKey;
        _ = FinishClose(agent);
    }

    private async Task FinishClose(AgentSnapshot agent)
    {
        var closed = await Task.Run(() => Hub.CloseAgent(agent.Key));
        if (closed.IsRaised)
        {
            return;
        }

        await InvokeAsync(() =>
        {
            closingNow.Remove(agent.Key);
            Notify($"{agent.Name}: {closed.How}", "warn");
            StateHasChanged();
        });
    }

