    private async Task Open(string key)
    {
        selectedKey = key;
        var agent = snapshot.Agents.FirstOrDefault(a => a.Key == key);
        if (agent is null)
        {
            return;
        }

        if (!agent.IsAlive)
        {
            await JS.InvokeVoidAsync("fx.shake", key);
            Notify($"{agent.Name} is closed · right-click to resume it, ctrl+click to close it", "warn");
            return;
        }

        await JS.InvokeVoidAsync("fx.launch", key);
        await Task.Delay(LAUNCH_LEAD);
        var result = Hub.Raise(key);
        if (!result.IsRaised)
        {
            await JS.InvokeVoidAsync("fx.shake", key);
            Notify($"{agent.Name}: {result.How}", "warn");
        }
    }

    private IReadOnlyList<ChatMessage>? talkFor;

    private Dictionary<string, ChatTally> talkCache = [];

    /// <summary>Messages each agent sent and received (system notes left out), recounted only when the chat changes.</summary>
    private Dictionary<string, ChatTally> Talk()
    {
        if (ReferenceEquals(talkFor, snapshot.Chat))
        {
            return talkCache;
        }

        var tally = new Dictionary<string, ChatTally>();
        foreach (var message in snapshot.Chat.Where(m => m.Channel != ChatChannel.System))
        {
            if (message.FromKey is { } from)
            {
                var current = tally.GetValueOrDefault(from) ?? new ChatTally(0, 0, null);
                tally[from] = current with { Sent = current.Sent + 1, LastAt = Later(current.LastAt, message.At) };
            }

            if (message.ToKey is { } to && to != message.FromKey)
            {
                var current = tally.GetValueOrDefault(to) ?? new ChatTally(0, 0, null);
                tally[to] = current with { Received = current.Received + 1, LastAt = Later(current.LastAt, message.At) };
            }
        }

        talkFor = snapshot.Chat;
        talkCache = tally;
        return tally;
    }

    private static DateTimeOffset Later(DateTimeOffset? a, DateTimeOffset b)
    {
        return a is { } value && value > b ? value : b;
    }

