    /// <summary>
    /// A soft rising pair when an agent starts waiting on the user (a prompt, a question, a question while it works), a
    /// soft falling pair when it finishes its turn; one sound at a time, none for what was already so at startup.
    /// </summary>
    private async Task PlaySounds()
    {
        if (snapshot.IsLoading)
        {
            return;
        }

        var states = snapshot.Agents.ToDictionary(a => a.Key, a => a.State);
        var previous = lastStates;
        lastStates = states;
        if (previous is null || !Hub.Settings.SoundOn || DateTimeOffset.Now - lastSound < SOUND_GAP)
        {
            return;
        }

        string? sound = null;
        foreach (var agent in snapshot.Agents)
        {
            var before = previous.GetValueOrDefault(agent.Key, agent.State);
            var wasBusy = before is AgentState.Working or AgentState.UsingEditor or AgentState.LaneBlocked or AgentState.Asked;
            if (agent.State == before || !wasBusy)
            {
                continue;
            }

            var isWaiting = agent.State is AgentState.Asked or AgentState.NeedsInput;
            var isFinished = agent.State is AgentState.Finished or AgentState.Paused;
            sound = isWaiting ? "await" : isFinished ? sound ?? "finish" : sound;
        }

        if (sound is not null)
        {
            lastSound = DateTimeOffset.Now;
            await JS.InvokeVoidAsync("fx.sound", sound);
        }
    }

